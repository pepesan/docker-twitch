// Grafana Alloy — recolector de logs del stack (sustituye a Promtail, que
// llegó a fin de vida el 2-mar-2026). Mantiene las mismas etiquetas que
// usaba Promtail: `container` y `stream` para los contenedores y
// `job="syslog"` para el sistema del host.

// ---- Contenedores Docker del host (vía socket Docker) ----
// Pregunta al socket Docker cada refresh_interval qué contenedores hay
// corriendo (en todo el host, no solo en este proyecto) y expone cada uno
// como un "target" con sus metadatos (__meta_docker_*), que discovery.relabel
// convierte después en las etiquetas finales del stream de Loki.
discovery.docker "contenedores" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

// Convierte los metadatos crudos de Docker (__meta_docker_*, que no viajan a
// Loki) en las etiquetas finales del stream (container, job), que sí se
// indexan. Sin este paso, loki.source.docker etiquetaría cada log solo con
// el ID del contenedor.
discovery.relabel "contenedores" {
  targets = discovery.docker.contenedores.targets

  // /nombre -> nombre
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  // `job` como en la convención de Loki (proyecto/servicio), que usan los
  // dashboards comunitarios; para contenedores fuera de compose, su nombre.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "job"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project", "__meta_docker_container_label_com_docker_compose_service"]
    separator     = "/"
    regex         = "(.+)/(.+)"
    target_label  = "job"
    replacement   = "${1}/${2}"
  }
}



// Hace el tail real de la salida (stdout/stderr) de cada contenedor
// descubierto arriba, usando las etiquetas ya calculadas por
// discovery.relabel, y los reenvía al receptor indicado en forward_to
// (aquí, solo el Destino 1: escritura directa a Loki).
loki.source.docker "contenedores" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.contenedores.output
  forward_to       = [loki.write.loki.receiver]
  refresh_interval = "5s"
}

// ---- Igual que arriba, pero solo los contenedores de ESTE stack, y con
// destino al OTel Collector por OTLP (Destino 2). El host puede tener otros
// proyectos Docker corriendo con mucho más volumen de logs; mandar TODO ese
// tráfico ajeno por OTLP agota el rate-limit de ingesta OTLP de Loki (4
// MiB/s por tenant) sin aportar nada a este laboratorio.
discovery.relabel "contenedores_lab" {
  targets = discovery.docker.contenedores.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "46_curso_sre_observabilidad"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project", "__meta_docker_container_label_com_docker_compose_service"]
    separator     = "/"
    regex         = "(.+)/(.+)"
    target_label  = "job"
    replacement   = "${1}/${2}"
  }
}

// Mismo tail que el de arriba, pero sobre el subconjunto ya filtrado
// (discovery.relabel.contenedores_lab) y con destino al Destino 2 (OTLP).
loki.source.docker "contenedores_lab" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.contenedores_lab.output
  forward_to       = [otelcol.receiver.loki.bridge.receiver]
  refresh_interval = "5s"
}

// ---- Logs del sistema Linux del host (/var/log montado en /var/log/host) ----
// local.file_match localiza el fichero y le asigna la etiqueta job=syslog;
// no lee contenido, solo descubre la ruta.
local.file_match "syslog" {
  path_targets = [{
    __path__ = "/var/log/host/syslog",
    job      = "syslog",
  }]
}

// Hace el tail real del fichero localizado arriba (igual que `tail -f`), con
// la etiqueta job=syslog ya asignada. Solo al Destino 1: el volumen de
// syslog es del host entero, no de este proyecto, igual que el razonamiento
// de discovery.relabel.contenedores_lab más arriba.
loki.source.file "syslog" {
  targets    = local.file_match.syslog.targets
  forward_to = [loki.write.loki.receiver]
}

// ---- Destino 1: escritura directa a Loki (igual que antes) ----
loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ---- Destino 2 (complementario, solo logs de este stack): se convierte a
// OTLP y se manda al OTel Collector (pipeline "logs" de
// otel-collector-config.yaml), que hace su propio push a Loki vía el
// endpoint OTLP nativo. Deja tráfico real en ese pipeline sin depender de
// que una app lo use directamente; los logs que llegan por aquí aparecen en
// Loki con labels ligeramente distintas (atributos de recurso OTLP) a los
// que llegan por el Destino 1.
otelcol.receiver.loki "bridge" {
  output {
    logs = [otelcol.exporter.otlp.collector.input]
  }
}

otelcol.exporter.otlp "collector" {
  client {
    endpoint = "otel-collector:4317"
    tls {
      insecure = true
    }
  }
}
