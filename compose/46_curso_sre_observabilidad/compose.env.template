## Credenciales iniciales de Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=__GRAFANA_ADMIN_PASSWORD__

## Zona horaria (logs/paneles con hora local)
TZ=Europe/Madrid

## Notificaciones por email desde Grafana, contra el servidor SMTP de
## pruebas del propio laboratorio (servicio "mailserver", sin TLS ni auth).
## Para un SMTP real externo, cambia host/user/password y descomenta
## GF_SMTP_SKIP_VERIFY solo si ese proveedor lo requiere.
GF_SMTP_ENABLED=true
GF_SMTP_HOST=mailserver:3025
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=grafana@lab.local
GF_SMTP_FROM_NAME=Grafana Curso SRE
GF_SMTP_SKIP_VERIFY=true
