pipeline {
  agent {
    docker {
      image 'alpine:3.20'
      label 'built-in'
      args '--network jenkins_docker_pipeline_default'
    }
  }

  stages {
    stage('Preparar Ansible y colección Docker') {
      steps {
        sh 'apk add --no-cache ansible openssh-client'
        sh "ansible-galaxy collection install --timeout 180 'community.docker:>=3.10.2' --force"
      }
    }

    stage('Generar inventario y ansible.cfg') {
      steps {
        withCredentials([string(credentialsId: 'ansible-lxc-ip', variable: 'LXC_IP')]) {
          sh '''
            cat > "$WORKSPACE/inventory.ini" <<EOF
[ubuntu]
ansible-lxc ansible_host=$LXC_IP
[webservers]
ansible-lxc ansible_host=$LXC_IP
[docker]
ansible-lxc ansible_host=$LXC_IP
EOF
            cat > "$WORKSPACE/ansible.cfg" <<EOF
[defaults]
inventory = $WORKSPACE/inventory.ini
host_key_checking = True
retry_files_enabled = False
interpreter_python = auto_silent
[ssh_connection]
pipelining = True
EOF
            mkdir -p "$HOME/.ssh"
            chmod 700 "$HOME/.ssh"
            ssh-keyscan -H "$LXC_IP" >> "$HOME/.ssh/known_hosts" 2>/dev/null
            chmod 600 "$HOME/.ssh/known_hosts"
          '''
        }
      }
    }

    stage('Comprobar Docker y SDK') {
      steps {
        withCredentials([
          sshUserPrivateKey(credentialsId: 'ansible-lxc-alumno-ssh', keyFileVariable: 'SSH_KEY')
        ]) {
          sh '''
            chmod 600 "$SSH_KEY"
            ANSIBLE_CONFIG="$WORKSPACE/ansible.cfg" ansible docker \
              -u alumno --private-key="$SSH_KEY" --become \
              -m ansible.builtin.command -a 'docker info'
            ANSIBLE_CONFIG="$WORKSPACE/ansible.cfg" ansible docker \
              -u alumno --private-key="$SSH_KEY" --become \
              -m ansible.builtin.apt -a 'name=python3-docker state=present update_cache=true'
          '''
        }
      }
    }

    stage('Retirar MariaDB y Adminer con Compose') {
      steps {
        withCredentials([
          sshUserPrivateKey(credentialsId: 'ansible-lxc-alumno-ssh', keyFileVariable: 'SSH_KEY')
        ]) {
          sh '''
            chmod 600 "$SSH_KEY"
            cat > "$WORKSPACE/uninstall-compose.yml" <<'EOF'
- name: Remove MariaDB Compose deployment while preserving database data
  hosts: docker
  become: true
  tasks:
    - name: Stop and remove MariaDB and Adminer containers and network
      community.docker.docker_compose_v2:
        project_src: /home/alumno/deploy-mariadb
        files:
          - compose.mariadb.yaml
        state: absent
    - name: Remove the deployment files but preserve the named data volume
      ansible.builtin.file:
        path: /home/alumno/deploy-mariadb
        state: absent
EOF
            ANSIBLE_CONFIG="$WORKSPACE/ansible.cfg" ansible-playbook \
              "$WORKSPACE/uninstall-compose.yml" \
              -u alumno --private-key="$SSH_KEY" --become
          '''
        }
      }
    }

    stage('Verificar retirada y conservar datos') {
      steps {
        withCredentials([
          sshUserPrivateKey(credentialsId: 'ansible-lxc-alumno-ssh', keyFileVariable: 'SSH_KEY')
        ]) {
          sh '''
            chmod 600 "$SSH_KEY"
            ANSIBLE_CONFIG="$WORKSPACE/ansible.cfg" ansible docker \
              -u alumno --private-key="$SSH_KEY" --become \
              -m ansible.builtin.shell \
              -a '! docker container inspect mariadb-compose >/dev/null 2>&1 && ! docker container inspect adminer-compose >/dev/null 2>&1 && ! docker network inspect deploy-mariadb_default >/dev/null 2>&1 && docker volume inspect deploy-mariadb_mariadb_data >/dev/null 2>&1'
          '''
        }
      }
    }
  }
}