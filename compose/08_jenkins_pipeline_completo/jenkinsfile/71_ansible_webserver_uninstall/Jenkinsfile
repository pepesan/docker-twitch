pipeline {
  agent {
    docker {
      image 'alpine:3.20'
      label 'built-in'
      args '--network jenkins_docker_pipeline_default'
    }
  }

  stages {
    stage('Preparar herramientas y playbook') {
      steps {
        sh 'apk add --no-cache ansible git openssh-client'
        sh '''
          rm -rf "$WORKSPACE/ansible-examples"
          git clone --depth 1 --branch master https://github.com/pepesan/ejemplos-ansible.git "$WORKSPACE/ansible-examples"
        '''
      }
    }

    stage('Generar inventario y ansible.cfg') {
      steps {
        withCredentials([string(credentialsId: 'ansible-lxc-ip', variable: 'LXC_IP')]) {
          sh '''
            cat > "$WORKSPACE/inventory.ini" <<EOF
[ubuntu]
ansible-lxc ansible_host=$LXC_IP
[webservers]
ansible-lxc ansible_host=$LXC_IP
[docker]
ansible-lxc ansible_host=$LXC_IP
EOF
            cat > "$WORKSPACE/ansible.cfg" <<EOF
[defaults]
inventory = $WORKSPACE/inventory.ini
host_key_checking = True
retry_files_enabled = False
interpreter_python = auto_silent
[ssh_connection]
pipelining = True
EOF
            mkdir -p "$HOME/.ssh"
            chmod 700 "$HOME/.ssh"
            ssh-keyscan -H "$LXC_IP" >> "$HOME/.ssh/known_hosts" 2>/dev/null
            chmod 600 "$HOME/.ssh/known_hosts"
          '''
        }
      }
    }

    stage('Comprobar SSH con alumno') {
      steps {
        withCredentials([
          sshUserPrivateKey(credentialsId: 'ansible-lxc-alumno-ssh', keyFileVariable: 'SSH_KEY'),
          string(credentialsId: 'ansible-lxc-ip', variable: 'LXC_IP')
        ]) {
          sh '''
            chmod 600 "$SSH_KEY"
            ANSIBLE_CONFIG="$WORKSPACE/ansible.cfg" ansible ubuntu -m ping \\
              -u alumno --private-key="$SSH_KEY" --become
          '''
        }
      }
    }

    stage('Desinstalar servidor web con Ansible') {
      steps {
        withCredentials([
          sshUserPrivateKey(credentialsId: 'ansible-lxc-alumno-ssh', keyFileVariable: 'SSH_KEY'),
          string(credentialsId: 'ansible-lxc-ip', variable: 'LXC_IP')
        ]) {
          sh '''
            chmod 600 "$SSH_KEY"
            ANSIBLE_CONFIG="$WORKSPACE/ansible.cfg" ansible-playbook \\
              "$WORKSPACE/ansible-examples/03_servidorweb/tasks_uninstall.yaml" \\
              -u alumno --private-key="$SSH_KEY" --become
          '''
        }
      }
    }

    stage('Verificar retirada de Nginx') {
      steps {
        sh '''
          cat > "$WORKSPACE/verify_nginx_removed.yaml" <<'EOF'
---
- name: Verificar que Nginx se ha retirado
  hosts: ubuntu
  become: true
  gather_facts: false
  tasks:
    - name: Consultar paquetes instalados
      ansible.builtin.package_facts:
        manager: auto

    - name: Comprobar que el paquete nginx no está instalado
      ansible.builtin.assert:
        that:
          - "'nginx' not in ansible_facts.packages"

    - name: Consultar estado del servicio Nginx
      ansible.builtin.command:
        argv:
          - systemctl
          - is-active
          - nginx
      register: nginx_service_state
      changed_when: false
      failed_when: false

    - name: Comprobar que el servicio Nginx no está activo
      ansible.builtin.assert:
        that:
          - nginx_service_state.rc != 0
EOF
        '''
        withCredentials([
          sshUserPrivateKey(credentialsId: 'ansible-lxc-alumno-ssh', keyFileVariable: 'SSH_KEY'),
          string(credentialsId: 'ansible-lxc-ip', variable: 'LXC_IP')
        ]) {
          sh '''
            chmod 600 "$SSH_KEY"
            ANSIBLE_CONFIG="$WORKSPACE/ansible.cfg" ansible-playbook \\
              "$WORKSPACE/verify_nginx_removed.yaml" \\
              -u alumno --private-key="$SSH_KEY" --become
          '''
        }
      }
    }
  }
}
