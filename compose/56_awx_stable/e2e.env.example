# Destino y credenciales SSH. Los valores reales van en e2e.env (ignorado por Git).
# Revalida host y estado antes de cada sesión:  lxc list  y  lxc info lxd-vm-auto
E2E_TARGET_HOST=10.207.154.161
E2E_TARGET_NAME=lxd-vm-auto
E2E_TARGET_USER=alumno
# El usuario alumno tiene sudo sin contraseña en la LXC; las plantillas activan
# Privilege Escalation. Pon false solo si E2E_TARGET_USER=root.
E2E_BECOME=true
# Ruta de la clave privada. La clave se carga en AWX (almacén cifrado); nunca se
# copia a este repositorio ni se imprime.
E2E_SSH_PRIVATE_KEY="$HOME/.ssh/id_ed25519"

# Repositorio público con 03_servidorweb y 14_docker.
E2E_REPOSITORY_URL=https://github.com/pepesan/ejemplos-ansible.git
E2E_REPOSITORY_BRANCH=master

# Nombres de los recursos que se crean en AWX.
E2E_ORGANIZATION=Default
E2E_INVENTORY_NAME=laboratorio
E2E_PROJECT_NAME=ejemplo-webserver

# Cuenta AWX dedicada que lanza las plantillas (la contraseña se genera en
# e2e-secrets.env).
E2E_USER_LOGIN=ansible_e2e
E2E_USER_NAME="Usuario E2E Ansible"
E2E_USER_EMAIL=ansible-e2e@localhost

# Segundos máximos por trabajo. El primero tarda más: AWX descarga la imagen
# del Execution Environment.
E2E_JOB_TIMEOUT=900
