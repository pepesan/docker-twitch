# Usuario/organización de Docker Hub donde se publica la imagen propia
AWX_DOCKERHUB_USER=pepesan
AWX_IMAGE_NAME=awx-devel
AWX_TAG=devel-20261008
# Imagen final que usa compose.yaml. Antes de hacer push apunta a la
# imagen local recién construida; tras 03_push_image.sh sigue siendo la
# misma referencia, ya publicada en Docker Hub.
AWX_IMAGE=pepesan/awx-devel:devel-20261008

AWX_PG_PORT=5441
AWX_HTTP_PORT=8013
AWX_HTTPS_PORT=8043

# Las contraseñas (AWX_PG_PASSWORD, AWX_ADMIN_PASSWORD) NO están aquí:
# se generan aleatoriamente la primera vez que se ejecuta ./00_init.sh,
# en ./secrets.env (gitignorado, nunca se sube al repo).
