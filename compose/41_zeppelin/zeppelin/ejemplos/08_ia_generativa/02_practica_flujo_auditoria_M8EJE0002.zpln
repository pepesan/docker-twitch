    {
      "text": "%python\nimport anthropic\n\n\ndef generar_borrador_informe(prompt, client, model\u003d\"claude-opus-5\"):\n    respuesta \u003d client.messages.create(\n        model\u003dmodel,\n        max_tokens\u003d1024,\n        system\u003d\"Eres un asistente de auditoría interna. Responde de forma breve y concreta.\",\n        messages\u003d[{\"role\": \"user\", \"content\": prompt}],\n    )\n    return next(bloque.text for bloque in respuesta.content if bloque.type \u003d\u003d \"text\")\n\n\nif not EJECUTAR_LLAMADA_REAL or not ANTHROPIC_API_KEY:\n    print(\"--- DRY RUN: prompt que se enviaría (no se ha llamado a ningún servicio) ---\")\n    print(prompt)\nelse:\n    client \u003d anthropic.Anthropic(api_key\u003dANTHROPIC_API_KEY)\n    borrador \u003d generar_borrador_informe(prompt, client)\n    print(\"--- Borrador generado (revisar antes de usar) ---\")\n    print(borrador)",
      "user": "anonymous",
      "dateUpdated": "2026-09-22 22:44:13.742",
      "progress": 0,
