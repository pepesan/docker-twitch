      "text": "%python\n# Ejemplo del Módulo 8: primera llamada a la API de Anthropic\n# (equivalente a ejemplos-python/src/modulo_08/01_llamada_basica.py)\nimport anthropic\n\nif not ANTHROPIC_API_KEY:\n    print(\"Completa ANTHROPIC_API_KEY en la celda anterior con tu propia clave antes de ejecutar esta celda.\")\nelse:\n    client \u003d anthropic.Anthropic(api_key\u003dANTHROPIC_API_KEY)\n\n    respuesta \u003d client.messages.create(\n        model\u003d\"claude-opus-5\",\n        max_tokens\u003d1024,\n        system\u003d\"Eres un asistente de auditoría interna. Responde de forma breve y concreta.\",\n        messages\u003d[{\"role\": \"user\", \"content\": \"¿Qué es una prueba sustantiva en auditoría?\"}],\n    )\n\n    for bloque in respuesta.content:\n        if bloque.type \u003d\u003d \"text\":\n            print(bloque.text)",
