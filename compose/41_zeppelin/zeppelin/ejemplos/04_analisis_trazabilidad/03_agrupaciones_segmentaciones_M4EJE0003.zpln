    {
      "text": "%python\n# Ejemplo del Módulo 4: totales por sucursal y segmentos por importe\n# (equivalente a ejemplos-python/src/modulo_04/03_agrupaciones_segmentaciones.py)\nimport pandas as pd\n\ndf \u003d pd.read_csv(\"/opt/zeppelin/notebook/ejemplos/04_analisis_trazabilidad/data/operaciones_auditoria.csv\")\n\nresumen_sucursal \u003d df.groupby(\"sucursal\")[\"importe\"].agg([\"count\", \"sum\", \"mean\"])\nprint(resumen_sucursal)\n\ndf[\"segmento\"] \u003d pd.cut(\n    df[\"importe\"],\n    bins\u003d[0, 500, 5000, float(\"inf\")],\n    labels\u003d[\"bajo\", \"medio\", \"alto\"],\n)\nprint(df[[\"id_operacion\", \"importe\", \"segmento\"]])\nprint(df[\"segmento\"].value_counts())",
