    {
      "text": "%python\n# Ejemplo del Módulo 4: corregir muchas filas a la vez con .loc\n# (equivalente a ejemplos-python/src/modulo_04/08_validaciones_correcciones.py)\nimport pandas as pd\n\ndf \u003d pd.read_csv(\"/opt/zeppelin/notebook/ejemplos/04_analisis_trazabilidad/data/operaciones_auditoria.csv\")\n\nsin_cuenta \u003d df[\"cuenta\"].isna()\nsin_importe \u003d df[\"importe\"].isna()\nprint(f\"Operaciones sin cuenta: {sin_cuenta.sum()}\")\nprint(f\"Operaciones sin importe: {sin_importe.sum()}\")\n\ndf_corregido \u003d df.copy()\ndf_corregido.loc[sin_cuenta, \"cuenta\"] \u003d \"PENDIENTE_REVISION\"\ndf_corregido.loc[sin_importe, \"importe\"] \u003d 0.0\n\nprint(df_corregido[sin_cuenta | sin_importe])",
