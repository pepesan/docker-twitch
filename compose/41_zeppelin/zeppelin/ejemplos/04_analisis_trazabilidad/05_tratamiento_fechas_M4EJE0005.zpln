      "text": "%python\n# Ejemplo del Módulo 4: de texto a fecha, y de fecha a información derivada\n# (equivalente a ejemplos-python/src/modulo_04/05_tratamiento_fechas.py)\nimport pandas as pd\n\ndf \u003d pd.read_csv(\"/opt/zeppelin/notebook/ejemplos/04_analisis_trazabilidad/data/operaciones_auditoria.csv\")\ndf[\"fecha\"] \u003d pd.to_datetime(df[\"fecha\"])\n\ndf[\"mes\"] \u003d df[\"fecha\"].dt.month\ndf[\"dia_semana\"] \u003d df[\"fecha\"].dt.day_name()\nprint(df[[\"id_operacion\", \"fecha\", \"mes\", \"dia_semana\"]])\n\nhoy \u003d pd.Timestamp(\"2026-01-12\")\ndf[\"dias_desde_operacion\"] \u003d (hoy - df[\"fecha\"]).dt.days\nprint(df[[\"id_operacion\", \"fecha\", \"dias_desde_operacion\"]])",
