    {
      "text": "%python\n# Ejemplo del Módulo 4: detectar y tratar huecos y duplicados\n# (equivalente a ejemplos-python/src/modulo_04/06_valores_perdidos_duplicados.py)\nimport pandas as pd\n\ndf \u003d pd.read_csv(\"/opt/zeppelin/notebook/ejemplos/04_analisis_trazabilidad/data/operaciones_auditoria.csv\")\n\nprint(df.isna().sum())\n\ndf_sin_duplicados \u003d df.drop_duplicates(subset\u003d\"id_operacion\", keep\u003d\"first\")\nprint(f\"Filas originales: {len(df)}, sin duplicados: {len(df_sin_duplicados)}\")\n\ndf_relleno \u003d df.copy()\ndf_relleno[\"cuenta\"] \u003d df_relleno[\"cuenta\"].fillna(\"SIN_CUENTA\")\ndf_sin_nulos \u003d df_relleno.dropna(subset\u003d[\"importe\"])\nprint(f\"Filas tras eliminar importes nulos: {len(df_sin_nulos)}\")",
      "user": "anonymous",
