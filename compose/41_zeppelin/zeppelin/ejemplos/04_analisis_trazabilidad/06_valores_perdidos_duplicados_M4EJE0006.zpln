      "jobName": "paragraph_M4EJE0006_4",
      "id": "paragraph_M4EJE0006_4",
      "dateCreated": "2026-09-15 20:39:18.718",
      "status": "READY"
    },
    {
      "text": "%python\n# Duplicados ocultos por formato: espacios y mayúsculas/minúsculas distintas\ncuentas_sucias = pd.Series([\" ES00-1234\", \"es00-5678\", \"ES00-9012 \", \"ES00-1234\"])\nprint(f\"Valores únicos antes de limpiar: {cuentas_sucias.nunique()}\")\n\ncuentas_limpias = cuentas_sucias.str.strip().str.upper()\nprint(f\"Valores únicos tras strip().upper(): {cuentas_limpias.nunique()}\")",
