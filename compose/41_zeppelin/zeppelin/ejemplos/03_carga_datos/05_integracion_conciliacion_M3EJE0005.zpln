    {
      "text": "%python\n# Ejemplo del Módulo 3: integración y conciliación de fuentes\n# (equivalente a ejemplos-python/src/modulo_03/05_integracion_conciliacion.py)\nimport pandas as pd\nfrom sqlalchemy import create_engine\n\nengine \u003d create_engine(\"postgresql+psycopg2://auditor:auditor@db:5432/auditoria\")\ndf_sistema \u003d pd.read_sql(\"SELECT id_operacion, importe FROM operaciones\", engine)\ndf_extracto \u003d pd.read_csv(\"/opt/zeppelin/notebook/ejemplos/03_carga_datos/data/movimientos_extracto.csv\")\n\nconciliacion \u003d df_sistema.merge(\n    df_extracto, on\u003d\"id_operacion\", how\u003d\"outer\", indicator\u003dTrue\n)\nprint(conciliacion)\n\nsolo_extracto \u003d conciliacion[conciliacion[\"_merge\"] \u003d\u003d \"right_only\"]\nsolo_sistema \u003d conciliacion[conciliacion[\"_merge\"] \u003d\u003d \"left_only\"]\nprint(f\"Operaciones solo en el extracto (no registradas en el sistema): {len(solo_extracto)}\")\nprint(f\"Operaciones solo en el sistema (no aparecen en el extracto): {len(solo_sistema)}\")",
