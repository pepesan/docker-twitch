      "id": "paragraph_M3EJE0002_4",
      "dateCreated": "2026-09-15 20:31:53.375",
      "status": "READY"
    },
    {
      "text": "%python\n# Ejemplo del Módulo 3: múltiples hojas y estructuras tabulares\n# (equivalente a ejemplos-python/src/modulo_03/02_multiples_hojas.py)\nhojas = pd.read_excel(ruta, sheet_name=None)\nprint(list(hojas.keys()))\n\ndf_todas = pd.concat(hojas.values(), ignore_index=True)\nprint(df_todas)\nprint(f\"Total operaciones combinadas: {len(df_todas)}\")",
