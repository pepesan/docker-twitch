    {
      "text": "%python\n# Paso 1: cargar solo la hoja MAD01\nimport pandas as pd\n\nruta = \"/opt/zeppelin/notebook/ejemplos/03_carga_datos/data/operaciones_sucursales.xlsx\"\n\ndf_mad01 = pd.read_excel(ruta, sheet_name=\"MAD01\")\nprint(df_mad01)\nprint(f\"Operaciones en MAD01: {len(df_mad01)}\")",
      "user": "anonymous",
