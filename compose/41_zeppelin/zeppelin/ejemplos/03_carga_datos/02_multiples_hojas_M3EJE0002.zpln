    {
      "text": "%python\n# Paso 3: combinar las hojas cargadas por separado\ndf_todas_manual = pd.concat([df_mad01, df_bil02], ignore_index=True)\nprint(df_todas_manual)\nprint(f\"Total operaciones combinadas a mano: {len(df_todas_manual)}\")",
