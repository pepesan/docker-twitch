    {
      "text": "%python\n# Ejemplo del Módulo 3: homogeneización de formatos y calidad del dato\n# (equivalente a ejemplos-python/src/modulo_03/06_homogeneizacion_calidad.py)\nimport pandas as pd\n\ndf \u003d pd.read_csv(\"/opt/zeppelin/notebook/ejemplos/03_carga_datos/data/movimientos_extracto.csv\")\n\ndf \u003d df.rename(columns\u003d{\"importe_banco\": \"importe\"})\ndf[\"fecha_valor\"] \u003d pd.to_datetime(df[\"fecha_valor\"], format\u003d\"%d/%m/%Y\")\nprint(df.dtypes)\nprint(df)\n\nprint(f\"Filas duplicadas: {df.duplicated(subset\u003d\u0027id_operacion\u0027).sum()}\")\nprint(f\"Importes nulos: {df[\u0027importe\u0027].isna().sum()}\")",
