    {
      "text": "%python\n# Ejemplo del Módulo 3: consultas SQL básicas\n# (equivalente a ejemplos-python/src/modulo_03/04_consultas_sql.py)\nimport pandas as pd\nfrom sqlalchemy import create_engine\n\nengine \u003d create_engine(\"postgresql+psycopg2://auditor:auditor@db:5432/auditoria\")\n\naltas \u003d pd.read_sql(\n    \"SELECT * FROM operaciones WHERE importe \u003e 1000 ORDER BY importe DESC\", engine\n)\nprint(altas)\n\nresumen \u003d pd.read_sql(\n    \"SELECT sucursal, COUNT(*) AS num_operaciones, SUM(importe) AS total \"\n    \"FROM operaciones GROUP BY sucursal\",\n    engine,\n)\nprint(resumen)",
      "user": "anonymous",
