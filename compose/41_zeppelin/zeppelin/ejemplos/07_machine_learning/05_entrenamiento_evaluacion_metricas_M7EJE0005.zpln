    {
      "text": "%python\n# Ejemplo del Módulo 7: métricas de evaluación más allá de la exactitud\n# (equivalente a ejemplos-python/src/modulo_07/05_entrenamiento_evaluacion_metricas.py)\nimport pandas as pd\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import classification_report, confusion_matrix\nfrom sklearn.model_selection import train_test_split\n\nruta \u003d \"/opt/zeppelin/notebook/ejemplos/07_machine_learning/data/operaciones_ml.csv\"\ndf \u003d pd.read_csv(ruta)\ndf \u003d df[~df[\"anomalia_inyectada\"]]\ncaracteristicas \u003d [\"importe\", \"dias_desde_revision\", \"num_operaciones_mes\", \"antiguedad_cuenta_anios\"]\n\nX_train, X_test, y_train, y_test \u003d train_test_split(\n    df[caracteristicas], df[\"riesgo_alto\"], test_size\u003d0.25, random_state\u003d42\n)\n\nmodelo \u003d LogisticRegression()\nmodelo.fit(X_train, y_train)\npredicciones \u003d modelo.predict(X_test)\n\nprint(\"Matriz de confusión (filas\u003dreal, columnas\u003dpredicho):\")\nprint(confusion_matrix(y_test, predicciones))\nprint()\nprint(classification_report(y_test, predicciones, target_names\u003d[\"riesgo_normal\", \"riesgo_alto\"]))",
      "user": "anonymous",
