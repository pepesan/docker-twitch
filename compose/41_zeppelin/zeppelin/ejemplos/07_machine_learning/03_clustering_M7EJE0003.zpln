    {
      "text": "%python\n# Ejemplo del Módulo 7: clustering (aprendizaje no supervisado)\n# (equivalente a ejemplos-python/src/modulo_07/03_clustering.py)\nimport pandas as pd\nfrom sklearn.cluster import KMeans\nfrom sklearn.preprocessing import StandardScaler\n\nruta \u003d \"/opt/zeppelin/notebook/ejemplos/07_machine_learning/data/operaciones_ml.csv\"\ndf \u003d pd.read_csv(ruta)\ndf \u003d df[~df[\"anomalia_inyectada\"]].copy()\ncaracteristicas \u003d [\"importe\", \"dias_desde_revision\", \"num_operaciones_mes\"]\n\nX_escalado \u003d StandardScaler().fit_transform(df[caracteristicas])\n\nmodelo \u003d KMeans(n_clusters\u003d3, random_state\u003d42, n_init\u003d10)\ndf[\"segmento\"] \u003d modelo.fit_predict(X_escalado)\n\nprint(df.groupby(\"segmento\")[caracteristicas].mean().round(1))\nprint(df[\"segmento\"].value_counts())",
      "user": "anonymous",
