      "text": "%python\n# Ejemplo del Módulo 7: detección de anomalías con IsolationForest\n# (equivalente a ejemplos-python/src/modulo_07/04_deteccion_anomalias.py)\nimport pandas as pd\nfrom sklearn.ensemble import IsolationForest\n\nruta \u003d \"/opt/zeppelin/notebook/ejemplos/07_machine_learning/data/operaciones_ml.csv\"\ndf \u003d pd.read_csv(ruta)\ncaracteristicas \u003d [\"importe\", \"dias_desde_revision\", \"num_operaciones_mes\", \"antiguedad_cuenta_anios\"]\n\nmodelo \u003d IsolationForest(contamination\u003d0.02, random_state\u003d42)\ndf[\"es_anomalia\"] \u003d modelo.fit_predict(df[caracteristicas]) \u003d\u003d -1\n\ndetectadas \u003d df[df[\"es_anomalia\"]]\nprint(f\"Anomalías detectadas: {len(detectadas)}\")\nprint(detectadas[[\"id_operacion\", \"importe\", \"anomalia_inyectada\"]])\n\nverdaderos_positivos \u003d detectadas[\"anomalia_inyectada\"].sum()\nprint(f\"De las 3 anomalías inyectadas, detectadas: {verdaderos_positivos}\")",
