      "text": "%python\n# Ejemplo del Módulo 7: clasificación binaria con regresión logística\n# (equivalente a ejemplos-python/src/modulo_07/01_clasificacion.py)\nimport pandas as pd\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.model_selection import train_test_split\n\nruta \u003d \"/opt/zeppelin/notebook/ejemplos/07_machine_learning/data/operaciones_ml.csv\"\ndf \u003d pd.read_csv(ruta)\ndf \u003d df[~df[\"anomalia_inyectada\"]]\ncaracteristicas \u003d [\"importe\", \"dias_desde_revision\", \"num_operaciones_mes\", \"antiguedad_cuenta_anios\"]\n\nX \u003d df[caracteristicas]\ny \u003d df[\"riesgo_alto\"]\n\nX_train, X_test, y_train, y_test \u003d train_test_split(X, y, test_size\u003d0.25, random_state\u003d42)\n\nmodelo \u003d LogisticRegression()\nmodelo.fit(X_train, y_train)\n\nprecision \u003d modelo.score(X_test, y_test)\nprint(f\"Exactitud (accuracy) en test: {precision:.2f}\")",
