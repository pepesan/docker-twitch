      "text": "%python\ndef detectar_incidencias(df):\n    incidencias \u003d []\n    # TODO: si (df[\"importe\"] \u003c 0).any(), añade \"Importes negativos detectados\"\n\n    # TODO: si df[\"cuenta\"].isna().any(), añade \"Operaciones sin cuenta asociada\"\n\n    # TODO: si (df[\"importe\"] \u003e UMBRAL_ALERTA).any(), añade \"Operaciones por encima del umbral de alerta\"\n\n    return incidencias\n\n\nincidencias \u003d detectar_incidencias(df)\nif incidencias:\n    for incidencia in incidencias:\n        print(f\"⚠ {incidencia}\")\nelse:\n    print(\"Sin incidencias detectadas (o pendiente de completar el TODO)\")",
