    {
      "text": "%python\n# Ejemplo del Módulo 2: funciones y módulos\n# (equivalente a ejemplos-python/src/modulo_02/04_funciones_modulos.py)\n\nimport statistics\n\n\ndef clasificar_operacion(importe, umbral\u003d1000):\n    \"\"\"Devuelve \u0027alto\u0027 o \u0027normal\u0027 según el umbral.\"\"\"\n    # umbral\u003d1000 es un valor por defecto: se puede llamar a la función sin\n    # indicarlo (usa 1000) o pasando otro valor distinto para ese umbral.\n    return \"alto\" if importe \u003e umbral else \"normal\"\n\n\nimportes \u003d [500, 1200, 75, 3400, 980]\nclasificadas \u003d [clasificar_operacion(i) for i in importes]\nprint(clasificadas)\nprint(f\"Media: {statistics.mean(importes):.2f}\")",
      "user": "anonymous",
