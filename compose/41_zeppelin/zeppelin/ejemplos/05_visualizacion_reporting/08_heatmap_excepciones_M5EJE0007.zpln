    {
      "text": "%python\n# Ejemplo del Módulo 5: heatmap de excepciones por sucursal y semana\n# (equivalente a ejemplos-python/src/modulo_05/08_heatmap_excepciones.py)\nimport matplotlib\n\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\nimport pandas as pd\nimport seaborn as sns\n\nruta \u003d \"/opt/zeppelin/notebook/ejemplos/05_visualizacion_reporting/data/operaciones_visualizacion.csv\"\ndf \u003d pd.read_csv(ruta, parse_dates\u003d[\"fecha\"])\n\n\ndef detectar_excepciones(df, factor\u003d1.5):\n    q1 \u003d df[\"importe\"].quantile(0.25)\n    q3 \u003d df[\"importe\"].quantile(0.75)\n    iqr \u003d q3 - q1\n    limite_superior \u003d q3 + factor * iqr\n    return df[df[\"importe\"] \u003e limite_superior]\n\n\nexcepciones \u003d detectar_excepciones(df).copy()\nexcepciones[\"semana\"] \u003d excepciones[\"fecha\"].dt.to_period(\"W\").astype(str)\ntabla \u003d excepciones.pivot_table(\n    index\u003d\"sucursal\", columns\u003d\"semana\", values\u003d\"importe\", aggfunc\u003d\"count\", fill_value\u003d0\n)\ntabla \u003d tabla.reindex(sorted(df[\"sucursal\"].unique()), fill_value\u003d0)\n\nfig, ax \u003d plt.subplots(figsize\u003d(8, 4))\nsns.heatmap(tabla, annot\u003dTrue, fmt\u003d\"d\", cmap\u003d\"Reds\", ax\u003dax)\nax.set_title(\"Excepciones por sucursal y semana\")\nfig.tight_layout()\nz.show(plt)\nplt.close(fig)\n\nprint(tabla)",
      "user": "anonymous",
