    {
      "text": "%python\n# Ejemplo del Módulo 5: cuadro de mando con subplots\n# (equivalente a ejemplos-python/src/modulo_05/05_cuadro_mando_subplots.py)\nimport matplotlib\n\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\nimport pandas as pd\n\nruta \u003d \"/opt/zeppelin/notebook/ejemplos/05_visualizacion_reporting/data/operaciones_visualizacion.csv\"\ndf \u003d pd.read_csv(ruta, parse_dates\u003d[\"fecha\"])\n\nfig, axes \u003d plt.subplots(2, 2, figsize\u003d(11, 8))\nfig.suptitle(\"Cuadro de mando — Operaciones\")\n\ntotales_por_dia \u003d df.groupby(\"fecha\")[\"importe\"].sum()\naxes[0, 0].plot(totales_por_dia.index, totales_por_dia.values)\naxes[0, 0].set_title(\"Importe total por día\")\n\nconteo \u003d df[\"sucursal\"].value_counts()\naxes[0, 1].bar(conteo.index, conteo.values)\naxes[0, 1].set_title(\"Nº operaciones por sucursal\")\n\naxes[1, 0].hist(df[\"importe\"], bins\u003d20)\naxes[1, 0].set_title(\"Distribución de importes\")\n\naxes[1, 1].boxplot(\n    [df.loc[df[\"sucursal\"] \u003d\u003d s, \"importe\"] for s in sorted(df[\"sucursal\"].unique())],\n    tick_labels\u003dsorted(df[\"sucursal\"].unique()),\n)\naxes[1, 1].set_title(\"Importes por sucursal\")\n\nfig.tight_layout()\nz.show(plt)\nplt.close(fig)\nprint(\"Cuadro de mando generado con 4 paneles\")",
      "user": "anonymous",
