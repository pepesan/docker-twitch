      "text": "%python\n# Ejemplo del Módulo 5: series temporales comparativas\n# (equivalente a ejemplos-python/src/modulo_05/04_series_temporales_comparativas.py)\nimport matplotlib\n\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\nimport pandas as pd\n\nruta \u003d \"/opt/zeppelin/notebook/ejemplos/05_visualizacion_reporting/data/operaciones_visualizacion.csv\"\ndf \u003d pd.read_csv(ruta, parse_dates\u003d[\"fecha\"])\n\nserie_por_sucursal \u003d df.pivot_table(index\u003d\"fecha\", columns\u003d\"sucursal\", values\u003d\"importe\", aggfunc\u003d\"sum\")\n\nfig, ax \u003d plt.subplots(figsize\u003d(9, 4))\nfor sucursal in serie_por_sucursal.columns:\n    ax.plot(serie_por_sucursal.index, serie_por_sucursal[sucursal], label\u003dsucursal, marker\u003d\"o\")\nax.set_title(\"Importe diario por sucursal\")\nax.legend()\nfig.tight_layout()\nz.show(plt)\nplt.close(fig)\n\nprint(serie_por_sucursal.head())",
