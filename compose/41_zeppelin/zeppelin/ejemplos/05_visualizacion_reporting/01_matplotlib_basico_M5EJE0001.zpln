      "text": "%python\n# Ejemplo del Módulo 5: primer gráfico con Matplotlib\n# (equivalente a ejemplos-python/src/modulo_05/01_matplotlib_basico.py)\nimport matplotlib\n\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\nimport pandas as pd\n\nruta \u003d \"/opt/zeppelin/notebook/ejemplos/05_visualizacion_reporting/data/operaciones_visualizacion.csv\"\ndf \u003d pd.read_csv(ruta, parse_dates\u003d[\"fecha\"])\n\ntotales_por_dia \u003d df.groupby(\"fecha\")[\"importe\"].sum()\n\nfig, ax \u003d plt.subplots(figsize\u003d(8, 4))\nax.plot(totales_por_dia.index, totales_por_dia.values)\nax.set_title(\"Importe total por día\")\nax.set_xlabel(\"Fecha\")\nax.set_ylabel(\"Importe (€)\")\nfig.tight_layout()\nz.show(plt)\nplt.close(fig)\n\nprint(f\"Días representados: {len(totales_por_dia)}\")",
