      "text": "%python\n# Ejemplo del Módulo 5: Seaborn — sintaxis orientada a DataFrame\n# (equivalente a ejemplos-python/src/modulo_05/03_seaborn_estilos.py)\nimport matplotlib\n\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\nimport pandas as pd\nimport seaborn as sns\n\nruta \u003d \"/opt/zeppelin/notebook/ejemplos/05_visualizacion_reporting/data/operaciones_visualizacion.csv\"\ndf \u003d pd.read_csv(ruta, parse_dates\u003d[\"fecha\"])\n\nsns.set_theme(style\u003d\"whitegrid\")\n\nfig, axes \u003d plt.subplots(1, 2, figsize\u003d(11, 4))\nsns.histplot(data\u003ddf, x\u003d\"importe\", hue\u003d\"sucursal\", bins\u003d20, ax\u003daxes[0])\naxes[0].set_title(\"Distribución de importes por sucursal\")\n\nsns.boxplot(data\u003ddf, x\u003d\"sucursal\", y\u003d\"importe\", ax\u003daxes[1])\naxes[1].set_title(\"Boxplot por sucursal (estilo Seaborn)\")\n\nfig.tight_layout()\nz.show(plt)\nplt.close(fig)\nprint(\"Gráficos Seaborn generados\")",
