      "text": "%python\n# Ejemplo del Módulo 5: histogramas, barras y boxplots\n# (equivalente a ejemplos-python/src/modulo_05/02_histogramas_barras_boxplots.py)\nimport matplotlib\n\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\nimport pandas as pd\n\nruta \u003d \"/opt/zeppelin/notebook/ejemplos/05_visualizacion_reporting/data/operaciones_visualizacion.csv\"\ndf \u003d pd.read_csv(ruta, parse_dates\u003d[\"fecha\"])\n\nfig, axes \u003d plt.subplots(1, 3, figsize\u003d(14, 4))\n\naxes[0].hist(df[\"importe\"], bins\u003d20)\naxes[0].set_title(\"Histograma de importes\")\n\nconteo \u003d df[\"sucursal\"].value_counts()\naxes[1].bar(conteo.index, conteo.values)\naxes[1].set_title(\"Nº de operaciones por sucursal\")\n\naxes[2].boxplot(\n    [df.loc[df[\"sucursal\"] \u003d\u003d s, \"importe\"] for s in sorted(df[\"sucursal\"].unique())],\n    tick_labels\u003dsorted(df[\"sucursal\"].unique()),\n)\naxes[2].set_title(\"Distribución de importes por sucursal\")\n\nfig.tight_layout()\nz.show(plt)\nplt.close(fig)\nprint(\"Gráficos generados: histograma, barras, boxplot\")",
