    {
      "text": "%python\n# Ejemplo del Módulo 5: exportación de resultados\n# (equivalente a ejemplos-python/src/modulo_05/06_exportacion_resultados.py)\nimport matplotlib\n\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\nimport pandas as pd\n\nruta \u003d \"/opt/zeppelin/notebook/ejemplos/05_visualizacion_reporting/data/operaciones_visualizacion.csv\"\ndf \u003d pd.read_csv(ruta, parse_dates\u003d[\"fecha\"])\n\nresumen \u003d df.groupby(\"sucursal\")[\"importe\"].agg([\"count\", \"sum\", \"mean\"]).round(2)\nresumen.to_csv(\"/tmp/resumen_sucursales.csv\")\nresumen.to_excel(\"/tmp/resumen_sucursales.xlsx\")\n\nfig, ax \u003d plt.subplots(figsize\u003d(6, 4))\nax.bar(resumen.index, resumen[\"sum\"])\nax.set_title(\"Importe total por sucursal\")\nfig.tight_layout()\nz.show(plt)\nplt.close(fig)\n\nprint(resumen)\nprint(\"Exportado a /tmp: CSV y Excel\")",
      "user": "anonymous",
