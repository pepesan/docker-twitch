# Usuario/organización de Docker Hub donde se publica la imagen propia
AWX_DOCKERHUB_USER=pepesan
AWX_IMAGE_NAME=awx-devel-scalable
AWX_TAG=devel
AWX_IMAGE=pepesan/awx-devel-scalable:devel

AWX_PG_PORT=5451
AWX_HTTP_PORT=8113
AWX_HTTPS_PORT=8143
# Puerto del servidor de desarrollo de la UI (webpack dev server), el
# 3000 original suele estar ocupado por otra cosa en el host.
AWX_UI_DEV_PORT=3301

# Topología: 1 control node + N execution nodes. El hop node de Receptor
# se genera automáticamente en cuanto AWX_EXECUTION_NODE_COUNT > 0 (es el
# propio tooling de ansible/awx el que lo decide así).
AWX_CONTROL_NODE_COUNT=1
AWX_EXECUTION_NODE_COUNT=2

# Las contraseñas (AWX_PG_PASSWORD, AWX_ADMIN_PASSWORD) NO están aquí:
# se generan aleatoriamente la primera vez que se ejecuta ./00_init.sh,
# en ./secrets.env (gitignorado, nunca se sube al repo).
