# Host Linux monitorizado. Obtén el valor con: hostname
HOST_LABEL=linux-host

# UID/GID sin privilegios con los que Alloy leerá y guardará sus posiciones.
# Obtén los valores en el host con: id -u && id -g
ALLOY_UID=1000
ALLOY_GID=1000

# Sustituye este texto por: openssl rand -hex 24
# No uses el valor de ejemplo ni publiques el fichero .env.
GRAFANA_ADMIN_PASSWORD=replace-locally-with-random-value
